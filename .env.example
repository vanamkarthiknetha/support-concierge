# Gemini — both names set; google-genai reads GEMINI_API_KEY,
# langchain-google-genai reads GOOGLE_API_KEY.
GEMINI_API_KEY=your-key-from-https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-from-https://aistudio.google.com/apikey

# Models (pinned — never floating aliases, see ADR-008)
MODEL_CHEAP=gemini-3.1-flash-lite
MODEL_SMART=gemini-3.7-flash

# Postgres
DATABASE_URL=postgresql://concierge:concierge@localhost:5434/concierge
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
POSTGRES_PORT=5434

# Routing thresholds (calibrated in Phase 4 via sweep — ADR-004)
TAU_AUTO=0.85
TAU_DRAFT=0.55

# LLM call limits
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
